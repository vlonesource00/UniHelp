# Configuração do SERVIDOR UniHelp. Copia para .env e preenche. O .env nunca se partilha nem vai no instalador.

# Conta de administração: utilizador "admin" + esta palavra-passe (12+ caracteres, obrigatória fora do 127.0.0.1)
ADMIN_PASSWORD=

# Rede: 127.0.0.1 = só este PC (ou atrás de um túnel); 0.0.0.0 = aceita ligações de outros computadores
HOST=127.0.0.1
PORT=8765
# 1 quando está atrás de um proxy/túnel (Cloudflare Tunnel, Fly.io, Render...)
TRUST_PROXY=0

# Envio de emails (códigos de 6 dígitos). Gmail: usa uma "palavra-passe de app", não a da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
